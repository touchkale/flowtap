<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Flowtap" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0F14</item>
        <!-- Transparent so edge-to-edge content shows through; icon contrast
            is driven at runtime per Compose theme (see SystemBarAppearance). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Invisible theme for the NFC router activity -->
    <style name="Theme.NfcRouter" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <!-- Fullscreen overlay for blocked apps -->
    <style name="Theme.BlockOverlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A1411</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>

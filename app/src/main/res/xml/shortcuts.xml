<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="start_focus"
        android:enabled="true"
        android:icon="@drawable/ic_stat_focus"
        android:shortcutShortLabel="@string/shortcut_start"
        android:shortcutLongLabel="@string/shortcut_start_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nfcfocus.app"
            android:targetClass="com.flowtap.app.MainActivity">
            <extra android:name="action" android:value="start_focus" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="end_session"
        android:enabled="true"
        android:icon="@drawable/ic_stat_focus"
        android:shortcutShortLabel="@string/shortcut_end"
        android:shortcutLongLabel="@string/shortcut_end_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.nfcfocus.app"
            android:targetClass="com.flowtap.app.MainActivity">
            <extra android:name="action" android:value="end_session" />
        </intent>
    </shortcut>
</shortcuts>
